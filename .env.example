# Copy to .env. Secrets go in secrets/*.txt (see README), NOT here.

# --- TigerBay Nimble API ---------------------------------------------------
# Production tenant is expected to be https://beachcomber.ontigerbay.co.uk/nimble;
# preproduction is https://beachcomber-preproduction.ontigerbay.co.uk/nimble
TIGERBAY_BASE_URL=https://beachcomber.ontigerbay.co.uk/nimble
TIGERBAY_OAUTH_TOKEN_URL=https://beachcomber.ontigerbay.co.uk/nimble/security/users/authenticate
TIGERBAY_CLIENT_ID=
TIGERBAY_TIMEOUT=30

# --- HubSpot ----------------------------------------------------------------
HUBSPOT_BASE_URL=https://api.hubapi.com
# Requests per rolling 10s we allow ourselves (private-app burst limit is 100 on
# Starter, 190 on Pro/Enterprise). Keep headroom for other integrations.
HUBSPOT_RATE_PER_10S=80
# flag  = set "TigerBay Archived" on the HubSpot record (default, reversible)
# delete = move the HubSpot record to the recycle bin
HUBSPOT_ARCHIVE_ACTION=flag
# Lifecycle stage set ONLY when a contact is first created (blank = HubSpot default).
# e.g. customer / lead / subscriber
HUBSPOT_CUSTOMER_LIFECYCLE=lead
HUBSPOT_STAFF_LIFECYCLE=lead
# Also mirror the agency as a HubSpot company and associate staff contacts to it.
# Off: the existing HubSpot data keeps agency details on the staff contact
# (agency_name / abta_reference) and has no agency companies.
SYNC_AGENT_COMPANIES=false
# true = compute and log diffs, never write to HubSpot. Use for the first run.
DRY_RUN=false

# --- Inbound webhook auth (TigerBay -> beachsync). Configure at least one. -----
WEBHOOK_BASIC_USER=tigerbay
# password: secrets/webhook_basic_password.txt
WEBHOOK_HEADER_NAME=X-Webhook-Token
# header value: secrets/webhook_header_value.txt

# --- Runtime -------------------------------------------------------------------
WORKER_POLL_SECONDS=2
MAX_ATTEMPTS=30
LOG_LEVEL=INFO
